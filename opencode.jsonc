{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "small_model": "opencode/nemotron-3.5-lightening-free",
  "permission": {
    "edit": {
      "opencode.json*": "ask",
      "**/opencode.json*": "ask",
      "eslint.config.*": "ask",
      "**/eslint.config.*": "ask",
      ".eslint*": "ask",
      "**/.eslint*": "ask",
      "tsconfig*.json*": "ask",
      "**/tsconfig*.json*": "ask",
      ".prettierrc*": "ask",
      "**/.prettierrc*": "ask",
      "prettier.config.*": "ask",
      "**/prettier.config.*": "ask",
    },
    "bash": {
      "git reset*": "ask",
      "git rebase*": "ask",
      "git stash*": "ask",
      "git reflog*": "ask",
      "git clean*": "ask",
      "git restore*": "ask",
      "git checkout --*": "ask",
      "git rm*": "ask",
      "git push --force*": "ask",
      "git push -f*": "ask",
      "git revert*": "ask",
      "git branch -D*": "ask",
      "git cherry-pick*": "ask",
      "git checkout -B*": "ask",
      "git filter-branch*": "ask",
      "git filter-repo*": "ask",
      "git prune*": "ask",
      "git gc*": "ask",
      "git update-ref*": "ask",
      "rmdir*": "ask",
      "shred*": "ask",
      "truncate*": "ask",
      "rm *": "ask",
      "rm": "ask",
    },
  },
  "agent": {
    "explore": {
      "model": "opencode/nemotron-3.5-lightening-free",
    },
    "code-reviewer": {
      "description": "Reviews code for quality, standards adherence, and defects",
      "mode": "subagent",
      "reasoningEffort": "high",
    },
  },
}
