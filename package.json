{
  "name": "assessmentbot-llm-service",
  "version": "0.7.0",
  "type": "module",
  "description": "The backend for Assessment Bot, which provides LLM services.",
  "author": "Hamish Arnold",
  "private": true,
  "license": "ISC",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "debug": "node --inspect-brk ./node_modules/.bin/nest start",
    "start:prod": "NODE_ENV=production node dist/src/main.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "generate:api-key": "node --experimental-strip-types scripts/generate-api-key.ts",
    "lint:british": "./scripts/check-british-english.sh",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:cov": "vitest run --coverage --project unit",
    "test:debug": "node --inspect-brk node_modules/.bin/vitest run --project unit --pool=forks --poolOptions.forks.singleFork",
    "test:e2e": "npm run build && vitest run --project e2e",
    "test:e2e:live": "npm run build && vitest run --project e2e-live",
    "prepare": "husky"
  },
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@mistralai/mistralai": "^2.7.0",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.7.1",
    "dotenv": "^18.0.6",
    "jsonrepair": "^3.15.0",
    "mustache": "^4.2.0",
    "nestjs-pino": "^5.3.1",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "validator": "^13.15.35",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.6",
    "@nestjs/testing": "^12.1.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^5.0.6",
    "@types/mustache": "^4.2.6",
    "@types/node": "^26.6.4",
    "@types/passport": "^1.0.17",
    "@types/passport-http-bearer": "^1.0.42",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^5.0.3",
    "axios": "^1.20.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^65.2.0",
    "eslint-plugin-n": "^18.4.1",
    "eslint-plugin-no-secrets": "^2.3.3",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-regexp": "^3.3.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "why-is-node-running": "3.2.2",
    "micromatch": ">=4.0.8",
    "lodash": "4.18.1",
    "multer": "2.4.0",
    "@angular-devkit/core": {
      "ajv": "8.20.0"
    },
    "@nestjs/schematics": {
      "ajv": "8.20.0"
    }
  },
  "homepage": "https://github.com/h-arnold/AssessmentBot-LLM-Service#readme",
  "lint-staged": {
    "*.ts": "eslint --fix",
    "*.{js,ts,json,md}": "prettier --write",
    "*.{ts,js,mjs,md}": "./scripts/check-british-english.sh",
    "*.env*": "./scripts/check-british-english.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h-arnold/AssessmentBot-LLM-Service.git"
  },
  "bugs": {
    "url": "https://github.com/h-arnold/AssessmentBot-LLM-Service/issues"
  }
}
